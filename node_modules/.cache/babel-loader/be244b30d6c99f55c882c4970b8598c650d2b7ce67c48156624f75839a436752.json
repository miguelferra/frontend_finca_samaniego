{"ast":null,"code":"export default {\n  name: 'ProductBox',\n  props: {\n    product: Object\n  }\n};","map":{"version":3,"names":["name","props","product","Object"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/components/ProductBox.vue"],"sourcesContent":["<template>\n  <div class=\"column is-3\">\n    <div class=\"box\">\n      <figure class=\"image mb-4\">\n        <img v-bind:src=\"product.thumbnail_url\">\n      </figure>\n\n      <h3 class=\"is-size-4\">{{ product.name }}</h3>\n      <p class=\"is-size-6 has-text-grey\">${{ product.price }}</p>\n\n      <router-link v-bind:to=\"product.get_absolute_url\" class=\"button is-dark mt-4\">View details</router-link>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'ProductBox',\n  props: {\n    product: Object\n  }\n}\n</script>\n\n<style scoped>\n/* 3. Se elimina el código del fondo de aquí */\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n}\n\n.hero.is-dark {\n  background-size: cover;\n  background-position: center;\n  position: relative;\n}\n\n/* Opcional: puedes dejar un overlay oscuro si quieres */\n.hero.is-dark::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.4); /* Overlay oscuro */\n}\n\n/* El hero-body necesita estar por encima del overlay */\n.hero-body {\n  position: relative;\n  z-index: 1;\n}\n</style>\n"],"mappings":"AAgBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,OAAO,EAAEC;EACX;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}