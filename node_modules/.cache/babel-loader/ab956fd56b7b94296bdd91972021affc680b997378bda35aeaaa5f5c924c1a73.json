{"ast":null,"code":"import \"core-js/modules/es.array.concat.js\";\nexport default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true\n    }\n  },\n  methods: {\n    getImageUrl: function getImageUrl() {\n      // Prioridad: thumbnail_url > image_url > placeholder\n      if (this.product.thumbnail_url) {\n        return this.product.thumbnail_url;\n      } else if (this.product.image_url) {\n        return this.product.image_url;\n      } else {\n        return \"/placeholder-image.jpg\"; // Imagen por defecto\n      }\n    },\n    getProductUrl: function getProductUrl() {\n      // Construir URL manualmente porque get_absolute_url no existe en el serializer\n      if (this.canNavigate()) {\n        return \"/product/\".concat(this.product.category_slug, \"/\").concat(this.product.slug);\n      }\n      return \"/\";\n    },\n    canNavigate: function canNavigate() {\n      // Verificar que tenemos todos los datos necesarios para navegar\n      return this.product.slug && this.product.category_slug;\n    },\n    handleImageError: function handleImageError(event) {\n      console.warn(\"Failed to load image:\", event.target.src);\n      // Fallback a una imagen por defecto\n      event.target.src = \"/placeholder-image.jpg\";\n    }\n  }\n};","map":{"version":3,"names":["name","props","product","type","Object","required","methods","getImageUrl","thumbnail_url","image_url","getProductUrl","canNavigate","concat","category_slug","slug","handleImageError","event","console","warn","target","src"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/components/ProductBox.vue"],"sourcesContent":["<template>\n  <div class=\"column is-3\">\n    <div class=\"box\">\n      <figure class=\"image mb-4\">\n        <img\n          :src=\"getImageUrl()\"\n          :alt=\"product.name\"\n          @error=\"handleImageError\"\n        />\n      </figure>\n\n      <h3 class=\"is-size-4\">{{ product.name }}</h3>\n      <p class=\"is-size-6 has-text-grey\">${{ product.price }}</p>\n\n      <router-link\n        v-bind:to=\"product.get_absolute_url\"\n        class=\"button is-dark mt-4\"\n        >View details</router-link\n      >\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true,\n    },\n  },\n\n  methods: {\n    getImageUrl() {\n      // Prioridad: thumbnail_url > image_url > placeholder\n      if (this.product.thumbnail_url) {\n        return this.product.thumbnail_url;\n      } else if (this.product.image_url) {\n        return this.product.image_url;\n      } else {\n        return \"/placeholder-image.jpg\"; // Imagen por defecto\n      }\n    },\n\n    getProductUrl() {\n      // Construir URL manualmente porque get_absolute_url no existe en el serializer\n      if (this.canNavigate()) {\n        return `/product/${this.product.category_slug}/${this.product.slug}`;\n      }\n      return \"/\";\n    },\n\n    canNavigate() {\n      // Verificar que tenemos todos los datos necesarios para navegar\n      return this.product.slug && this.product.category_slug;\n    },\n\n    handleImageError(event) {\n      console.warn(\"Failed to load image:\", event.target.src);\n      // Fallback a una imagen por defecto\n      event.target.src = \"/placeholder-image.jpg\";\n    },\n  },\n};\n</script>\n\n<style scoped>\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n  object-fit: cover;\n  width: 100%;\n  height: 200px; /* Altura fija para consistencia */\n}\n\n.box {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.hero.is-dark {\n  background-size: cover;\n  background-position: center;\n  position: relative;\n}\n\n.hero.is-dark::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.4);\n}\n\n.hero-body {\n  position: relative;\n  z-index: 1;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .column.is-3 {\n    width: 50%;\n  }\n}\n\n@media (max-width: 480px) {\n  .column.is-3 {\n    width: 100%;\n  }\n}\n</style>\n"],"mappings":";AAwBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,OAAO,EAAE;MACPC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDC,OAAO,EAAE;IACPC,WAAW,WAAXA,WAAWA,CAAA,EAAG;MACZ;MACA,IAAI,IAAI,CAACL,OAAO,CAACM,aAAa,EAAE;QAC9B,OAAO,IAAI,CAACN,OAAO,CAACM,aAAa;MACnC,OAAO,IAAI,IAAI,CAACN,OAAO,CAACO,SAAS,EAAE;QACjC,OAAO,IAAI,CAACP,OAAO,CAACO,SAAS;MAC/B,OAAO;QACL,OAAO,wBAAwB,EAAE;MACnC;IACF,CAAC;IAEDC,aAAa,WAAbA,aAAaA,CAAA,EAAG;MACd;MACA,IAAI,IAAI,CAACC,WAAW,CAAC,CAAC,EAAE;QACtB,mBAAAC,MAAA,CAAmB,IAAI,CAACV,OAAO,CAACW,aAAa,OAAAD,MAAA,CAAI,IAAI,CAACV,OAAO,CAACY,IAAI;MACpE;MACA,OAAO,GAAG;IACZ,CAAC;IAEDH,WAAW,WAAXA,WAAWA,CAAA,EAAG;MACZ;MACA,OAAO,IAAI,CAACT,OAAO,CAACY,IAAG,IAAK,IAAI,CAACZ,OAAO,CAACW,aAAa;IACxD,CAAC;IAEDE,gBAAgB,WAAhBA,gBAAgBA,CAACC,KAAK,EAAE;MACtBC,OAAO,CAACC,IAAI,CAAC,uBAAuB,EAAEF,KAAK,CAACG,MAAM,CAACC,GAAG,CAAC;MACvD;MACAJ,KAAK,CAACG,MAAM,CAACC,GAAE,GAAI,wBAAwB;IAC7C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}