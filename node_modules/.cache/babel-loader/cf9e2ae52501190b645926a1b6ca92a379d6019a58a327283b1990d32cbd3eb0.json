{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: '/background.jpg'\n    };\n  },\n  components: {},\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    async getLatestProducts() {\n      this.$store.commit(\"setLoading\", true);\n      await axios.get('api/latest/').then(response => {\n        this.latestProducts = response.data;\n      }).catch(error => {\n        console.error('Error fetching latest products:', error);\n      });\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","latestProducts","imageUrl","components","mounted","getLatestProducts","methods","$store","commit","get","then","response","catch","error","console"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <section \n      class=\"hero is-medium is-dark mb-6\"\n      :style=\"{ backgroundImage: 'url(' + imageUrl + ')' }\"\n    >\n      <div class=\"hero-body has-text-centered\">\n        <div class=\"container\">\n          <h1 class=\"title\">Bienvenido a Finca Samaniego</h1>\n          <h2 class=\"subtitle\">\n            Descubre nuestros productos frescos y orgánicos.\n          </h2>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered mb-4\">\n         Products\n        </h2>\n      </div>\n      <div class=\"is-loading-bar has-text-centered\" v-bind:class=\"{'is-loading': $store.state.isLoading}\">\n          <div class=\"lds-dual-ring\"></div>\n        </div>\n      <div\n        class=\"column is-3\"\n        v-for=\"product in latestProducts\"\n        :key=\"product.id\"\n      >\n        <div class=\"box\">\n          <figure class=\"image mb-4\">\n            <img :src=\"product.get_thumbnail\" alt=\"Product Image\" />\n          </figure>\n          <h3 class=\"title is-4\">{{ product.name }}</h3>\n          <p class=\"subtitle is-6 has-text-grey\">${{ product.price }}</p>\n          \n          <router-link v-bind:to=\"product.get_absolute_url\" class=\"button is-dark mt-4\">\n            Ver Producto\n          </router-link>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: '/background.jpg' \n    };\n  },\n  components: {},\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    async getLatestProducts() {\n      this.$store.commit(\"setLoading\", true);\n      await axios.get('api/latest/')\n        .then(response => {\n          this.latestProducts = response.data;\n        })\n        .catch(error => {\n          console.error('Error fetching latest products:', error);\n        });\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>\n\n<style scoped>\n/* 3. Se elimina el código del fondo de aquí */\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n}\n\n.hero.is-dark {\n  background-size: cover;\n  background-position: center;\n  position: relative;\n}\n\n/* Opcional: puedes dejar un overlay oscuro si quieres */\n.hero.is-dark::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.4); /* Overlay oscuro */\n}\n\n/* El hero-body necesita estar por encima del overlay */\n.hero-body {\n  position: relative;\n  z-index: 1;\n}\n\n.lds-dual-ring {\n  display: inline-block;\n  width: 80px;\n  height: 80px;\n  position: relative;\n  border-radius: 50%;\n  box-shadow: 0 0 20px #3498db55, 0 0 40px #00c3ff33;\n}\n\n.lds-dual-ring:after {\n  content: \" \";\n  display: block;\n  width: 64px;\n  height: 64px;\n  margin: 8px;\n  border-radius: 50%;\n  border: 8px solid transparent;\n  border-top: 8px solid #888888;   /* dark gray */\n  border-right: 8px solid #bbbbbb; /* medium gray */\n  border-bottom: 8px solid #dddddd;/* light gray */\n  border-left: 8px solid #f3f3f3;  /* very light gray */\n  animation: lds-dual-ring 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;\n  box-shadow: 0 0 30px #88888844;\n}\n\n@keyframes lds-dual-ring {\n  0% {\n    transform: rotate(0deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n  50% {\n    transform: rotate(180deg) scale(1.1);\n    box-shadow: 0 0 50px #00e6d088;\n  }\n  100% {\n    transform: rotate(360deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n}\n.is-loading-bar {\n  height: 0;\n  overflow: hidden;\n\n  -webkit-transition: all 0.3s ease-in-out;\n  transition: all 0.3s ease-in-out;\n\n  &.is-loading {\n    height: 80px;\n  }\n}\n</style>"],"mappings":"AA+CA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,EAAE;MAClB;MACAC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,UAAU,EAAE,CAAC,CAAC;EACdC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,iBAAiBA,CAAA,EAAG;MACxB,IAAI,CAACE,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,IAAI,CAAC;MACtC,MAAMV,KAAK,CAACW,GAAG,CAAC,aAAa,EAC1BC,IAAI,CAACC,QAAO,IAAK;QAChB,IAAI,CAACV,cAAa,GAAIU,QAAQ,CAACX,IAAI;MACrC,CAAC,EACAY,KAAK,CAACC,KAAI,IAAK;QACdC,OAAO,CAACD,KAAK,CAAC,iCAAiC,EAAEA,KAAK,CAAC;MACzD,CAAC,CAAC;MACJ,IAAI,CAACN,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,KAAK,CAAC;IACzC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}