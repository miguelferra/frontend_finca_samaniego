{"ast":null,"code":"import \"core-js/modules/es.function.name.js\";\nimport { toDisplayString as _toDisplayString, createElementVNode as _createElementVNode, renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, resolveComponent as _resolveComponent, createBlock as _createBlock } from \"vue\";\nvar _hoisted_1 = {\n  \"class\": \"page-category\"\n};\nvar _hoisted_2 = {\n  \"class\": \"columns is-multiline\"\n};\nvar _hoisted_3 = {\n  \"class\": \"column is-12\"\n};\nvar _hoisted_4 = {\n  \"class\": \"is-size-2 has-text-centered\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  var _component_ProductBox = _resolveComponent(\"ProductBox\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createElementVNode(\"div\", _hoisted_2, [_createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"h2\", _hoisted_4, _toDisplayString($data.category.name), 1 /* TEXT */)]), (_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.category.products, function (product) {\n    return _openBlock(), _createBlock(_component_ProductBox, {\n      key: product.id,\n      product: product\n    }, null, 8 /* PROPS */, [\"product\"]);\n  }), 128 /* KEYED_FRAGMENT */))])]);\n}","map":{"version":3,"names":["_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","_toDisplayString","$data","category","name","_Fragment","_renderList","products","product","_createBlock","_component_ProductBox","key","id"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/views/CategoryView.vue"],"sourcesContent":["<template>\n  <div class=\"page-category\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered\">{{ category.name }}</h2>\n      </div>\n      <ProductBox\n        v-for=\"product in category.products\"\n        :key=\"product.id\"\n        :product=\"product\"\n      />\n    </div>\n  </div>\n</template>\n\n<script>\n// Ya no necesitas axios ni bulma-toast aquí\nimport ProductBox from \"@/components/ProductBox.vue\";\n\n// 1. Define TODOS tus productos en un solo lugar.\n//    (En un proyecto más grande, esto podría ir en un archivo separado)\nconst allProducts = [\n    {\n        \"id\": 3,\n        \"name\": \"Salsa el Vado\",\n        \"slug\": \"salsa_el_vado\",\n        \"description\": \"El auténtico sabor de Sonora en cada gota. Nuestra receta familiar, hecha como en casa.\",\n        \"price\": \"150.00\",\n        \"image\": \"http://res.cloudinary.com/dtfgigvrb/image/upload/v1756239525/ct1o8iywbtdowjjvued6.jpg\",\n        \"get_absolute_url\": \"/salsa_chiltepin/salsa_el_vado/\",\n        \"category_slug\": \"salsa_chiltepin\",\n        \"category_name\": \"Salsa Chiltepin\" // <-- Añadido para el título\n    },\n    {\n        \"id\": 2,\n        \"name\": \"Chiltepin Seco\",\n        \"slug\": \"chiltepin-seco\",\n        \"description\": \"Una presentación para los que quieren algo mas especifico\",\n        \"price\": \"100.00\",\n        \"image\": \"http://res.cloudinary.com/dtfgigvrb/image/upload/v1756239501/hb0y5qvysxs01vx58new.jpg\",\n        \"get_absolute_url\": \"/chiltepin_entero/chiltepin-seco/\",\n        \"category_slug\": \"chiltepin_entero\",\n        \"category_name\": \"Chiltepin Entero\" // <-- Añadido para el título\n    },\n    {\n        \"id\": 1,\n        \"name\": \"Chiltepin de 50g\",\n        \"slug\": \"chiltepin-50-g\",\n        \"description\": \"Una presentación para lo que están empezando\",\n        \"price\": \"150.00\",\n        \"image\": \"http://res.cloudinary.com/dtfgigvrb/image/upload/v1756239477/gsxgphc3fdy09oyvpbok.jpg\",\n        \"get_absolute_url\": \"/chiltepin_entero/chiltepin-50-g/\",\n        \"category_slug\": \"chiltepin_entero\",\n        \"category_name\": \"Chiltepin Entero\" // <-- Añadido para el título\n    }\n];\n\n\nexport default {\n  name: \"CategoryView\",\n  components: {\n    ProductBox,\n  },\n  data() {\n    return {\n      // Dejamos esto vacío, ya que se llenará con las propiedades computadas\n      category: {\n        products: [],\n        name: ''\n      }\n    };\n  },\n  // 2. Usamos una propiedad computada para filtrar dinámicamente\n  computed: {\n    category_slug() {\n      return this.$route.params.category_slug;\n    },\n    filteredCategory() {\n      // Filtra la lista completa de productos\n      const filteredProducts = allProducts.filter(\n        p => p.category_slug === this.category_slug\n      );\n\n      // Obtiene el nombre de la categoría del primer producto encontrado\n      const categoryName = filteredProducts.length > 0 ? filteredProducts[0].category_name : '';\n      \n      document.title = categoryName + ' | Finca Samaniego'; // Actualiza el título de la página\n\n      return {\n        products: filteredProducts,\n        name: categoryName\n      };\n    }\n  },\n  // 3. Eliminamos mounted() y methods: {} porque ya no se necesita la llamada a la API\n};\n</script>\n"],"mappings":";;;EACO,SAAM;AAAe;;EACnB,SAAM;AAAsB;;EAC1B,SAAM;AAAc;;EACnB,SAAM;AAA6B;;;uBAH7CA,mBAAA,CAWM,OAXNC,UAWM,GAVJC,mBAAA,CASM,OATNC,UASM,GARJD,mBAAA,CAEM,OAFNE,UAEM,GADJF,mBAAA,CAAgE,MAAhEG,UAAgE,EAAAC,gBAAA,CAArBC,KAAA,CAAAC,QAAQ,CAACC,IAAI,iB,sBAE1DT,mBAAA,CAIEU,SAAA,QAAAC,WAAA,CAHkBJ,KAAA,CAAAC,QAAQ,CAACI,QAAQ,YAA5BC,OAAO;yBADhBC,YAAA,CAIEC,qBAAA;MAFCC,GAAG,EAAEH,OAAO,CAACI,EAAE;MACfJ,OAAO,EAAEA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}