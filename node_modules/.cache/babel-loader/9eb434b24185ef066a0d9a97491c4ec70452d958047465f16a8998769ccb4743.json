{"ast":null,"code":"export default {\n  data() {\n    return {\n      showMobileMenu: false\n    };\n  }\n};","map":{"version":3,"names":["data","showMobileMenu"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/App.vue"],"sourcesContent":["<template>\n    <div id=\"wrapper\">\n      <header>\n        <nav class=\"navbar is-dark\">\n          <div class=\"navbar-brand\">\n            <a class=\"navbar-item\" href=\"/\">\n              <img src=\"@/assets/finca_sama.png\" alt=\"Finca Samaniego Logo\" />\n              </a>\n              <span class=\"navbar-item is-align-items-center\" style=\"display: flex; align-items: center;\">\n              <strong>Finca Samaniego</strong>\n              </span>\n              <a class=\"navbar-burger\"aria-label=\"menu\" aria-expanded=\"false\" data-target=\"navbar-menu\" @click=\"showMobileMenu = !showMobileMenu\">\n                <span aria-hidden=\"true\"></span>\n                <span aria-hidden=\"true\"></span>\n                <span aria-hidden=\"true\"></span>\n                <span aria-hidden=\"true\"></span>\n              </a>\n          </div>\n          <div class=\"navbar-menu\" id=\"navbar-menu\" v-bind:class=\"{'is-active': showMobileMenu}\">\n            <div class=\"navbar-end\">\n              <a class=\"navbar-item\" href=\"/\">Inicio</a>\n              <a class=\"navbar-item\" href=\"/about\">Nosotros</a>\n              <a class=\"navbar-item\" href=\"/salsa_chiltepin\">Productos</a>\n              <a class=\"navbar-item\" href=\"/contact\">Contacto</a>\n            </div>\n          </div>\n        </nav>\n\n        <div class=\"is-loading-bar has-text-centered\" v-bind:class=\"{'is-loading': $store.state.isLoading}\">\n          <div class=\"lds-dual-ring\"></div>\n        </div>\n        <section class=\"section\">\n          <router-view/>\n        </section>\n\n        <footer class=\"footer\">\n            <p class=\"content has-text-centered\">Finca Samaniego Copyright (c) 2025\n            </p>\n        </footer>\n      </header>\n    </div>\n  </template>\n\n<script>\nexport default{\n  data() {\n    return {\n      showMobileMenu: false,\n    };\n  },\n}</script>\n\n<style lang=\"scss\">\n@import '../node_modules/bulma/';\n\n.lds-dual-ring {\n  display: inline-block;\n  width: 80px;\n  height: 80px;\n  position: relative;\n  border-radius: 50%;\n  box-shadow: 0 0 20px #3498db55, 0 0 40px #00c3ff33;\n}\n\n.lds-dual-ring:after {\n  content: \" \";\n  display: block;\n  width: 64px;\n  height: 64px;\n  margin: 8px;\n  border-radius: 50%;\n  border: 8px solid transparent;\n  border-top: 8px solid #888888;   /* dark gray */\n  border-right: 8px solid #bbbbbb; /* medium gray */\n  border-bottom: 8px solid #dddddd;/* light gray */\n  border-left: 8px solid #f3f3f3;  /* very light gray */\n  animation: lds-dual-ring 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;\n  box-shadow: 0 0 30px #88888844;\n}\n\n@keyframes lds-dual-ring {\n  0% {\n    transform: rotate(0deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n  50% {\n    transform: rotate(180deg) scale(1.1);\n    box-shadow: 0 0 50px #00e6d088;\n  }\n  100% {\n    transform: rotate(360deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n}\n.is-loading-bar {\n  height: 0;\n  overflow: hidden;\n\n  -webkit-transition: all 0.3s ease-in-out;\n  transition: all 0.3s ease-in-out;\n\n  &.is-loading {\n    height: 80px;\n  }\n}\n</style>\n"],"mappings":"AA4CA,eAAc;EACZA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE;IAClB,CAAC;EACH;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}