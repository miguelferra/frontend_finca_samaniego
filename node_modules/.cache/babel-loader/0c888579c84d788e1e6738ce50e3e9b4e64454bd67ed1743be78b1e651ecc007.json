{"ast":null,"code":"export default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true\n    }\n  },\n  methods: {\n    // El manejador de errores sigue siendo útil\n    handleImageError: function handleImageError(event) {\n      console.warn(\"No se pudo cargar la imagen:\", event.target.src);\n      // Fallback a una imagen de placeholder\n      event.target.src = \"https://via.placeholder.com/300x200/cccccc/666666?text=Imagen+no+disponible\";\n    }\n  }\n  // REMOVED: Los métodos getImageUrl, getProductUrl y canNavigate ya no son necesarios\n};","map":{"version":3,"names":["name","props","product","type","Object","required","methods","handleImageError","event","console","warn","target","src"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/components/ProductBox.vue"],"sourcesContent":["<template>\n  <div class=\"column is-3\">\n    <div class=\"box\">\n      <figure class=\"image mb-4\">\n        <img\n          :src=\"product.thumbnail_url\"\n          :alt=\"product.name\"\n          @error=\"handleImageError\"\n        />\n      </figure>\n      <h3 class=\"is-size-4\">{{ product.name }}</h3>\n      <p class=\"is-size-6 has-text-grey\">${{ product.price }}</p>\n      \n      <router-link\n        :to=\"product.get_absolute_url\"\n        class=\"button is-dark mt-4\"\n      >\n        Ver detalles\n      </router-link>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true,\n    },\n  },\n  methods: {\n    // El manejador de errores sigue siendo útil\n    handleImageError(event) {\n      console.warn(\"No se pudo cargar la imagen:\", event.target.src);\n      // Fallback a una imagen de placeholder\n      event.target.src = \"https://via.placeholder.com/300x200/cccccc/666666?text=Imagen+no+disponible\";\n    },\n  },\n  // REMOVED: Los métodos getImageUrl, getProductUrl y canNavigate ya no son necesarios\n};\n</script>\n\n<style scoped>\n/* Tu CSS existente es bueno, lo dejamos como está */\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n  object-fit: cover;\n  width: 100%;\n  height: 200px;\n}\n.box {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n</style>"],"mappings":"AAwBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,OAAO,EAAE;MACPC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAO,EAAE;IACP;IACAC,gBAAgB,WAAhBA,gBAAgBA,CAACC,KAAK,EAAE;MACtBC,OAAO,CAACC,IAAI,CAAC,8BAA8B,EAAEF,KAAK,CAACG,MAAM,CAACC,GAAG,CAAC;MAC9D;MACAJ,KAAK,CAACG,MAAM,CAACC,GAAE,GAAI,6EAA6E;IAClG;EACF;EACA;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}