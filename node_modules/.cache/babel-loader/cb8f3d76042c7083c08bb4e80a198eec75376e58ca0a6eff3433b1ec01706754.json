{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  name: \"ProductView\",\n  data() {\n    return {\n      product: {},\n      quantity: 1\n    };\n  },\n  mounted() {\n    this.getProduct();\n  },\n  methods: {\n    getProduct() {\n      const category_slug = this.$route.params.category_slug;\n      const product_slug = this.$route.params.product_slug;\n      axios.get(`api/product/${category_slug}/${product_slug}/`).then(response => {\n        this.product = response.data;\n      }).catch(error => {\n        console.error('Error fetching product:', error);\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","product","quantity","mounted","getProduct","methods","category_slug","$route","params","product_slug","get","then","response","catch","error","console"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/ProductView.vue"],"sourcesContent":["<template>\n  <div class=\"product-view\">\n    <div class=\"columns is-multiline\">\n\n      <div class=\"column is-6\">\n        <figure class=\"image product-image\">\n          <img v-bind:src=\"product.get_image\" alt=\"Product Image\" />\n        </figure>\n      </div>\n\n      <div class=\"column is-6\">\n        <h1 class=\"title\">{{ product.name }}</h1>\n        <p class=\"subtitle is-5\">{{ product.description }}</p>\n\n        <hr>\n\n        <h2 class=\"subtitle is-4\">Detalles</h2>\n        <p><strong>Precio:</strong> ${{ product.price }}</p>\n\n        <div class=\"field has-addons mt-6\">\n          <div class=\"control\">\n            <input\n              type=\"number\"\n              class=\"input\"\n              v-model=\"quantity\"\n              min=\"1\"\n            />\n          </div>\n\n          <div class=\"control\">\n            <a class=\"button is-success\">Añadir al carrito</a>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nexport default {\n  name: \"ProductView\",\n  data() {\n    return {\n        product: {},\n        quantity: 1,\n    };\n  },\n  mounted() {\n    this.getProduct();\n  },\n  methods: {\n    getProduct() {\n      const category_slug = this.$route.params.category_slug;\n      const product_slug = this.$route.params.product_slug;\n      axios.get(`api/product/${category_slug}/${product_slug}/`)\n        .then(response => {\n          this.product = response.data;\n        })\n        .catch(error => {\n          console.error('Error fetching product:', error);\n        });\n    },\n  },\n};\n</script>\n\n<style>\n.product-image img {\n  width: 180px;    /* Set your desired width */\n  height: 180px;   /* Set your desired height */\n  object-fit: cover;\n  display: block;\n  margin: 0 auto;\n}\n</style>\n"],"mappings":"AAwCA,OAAOA,KAAI,MAAO,OAAO;AACzB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACHC,OAAO,EAAE,CAAC,CAAC;MACXC,QAAQ,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,UAAU,CAAC,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACPD,UAAUA,CAAA,EAAG;MACX,MAAME,aAAY,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACF,aAAa;MACtD,MAAMG,YAAW,GAAI,IAAI,CAACF,MAAM,CAACC,MAAM,CAACC,YAAY;MACpDX,KAAK,CAACY,GAAG,CAAC,eAAeJ,aAAa,IAAIG,YAAY,GAAG,EACtDE,IAAI,CAACC,QAAO,IAAK;QAChB,IAAI,CAACX,OAAM,GAAIW,QAAQ,CAACZ,IAAI;MAC9B,CAAC,EACAa,KAAK,CAACC,KAAI,IAAK;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;MACjD,CAAC,CAAC;IACN;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}