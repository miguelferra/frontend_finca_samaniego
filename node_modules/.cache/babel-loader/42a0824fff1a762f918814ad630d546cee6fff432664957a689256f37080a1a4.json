{"ast":null,"code":"import \"core-js/modules/es.array.concat.js\";\nexport default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true\n    }\n  },\n  methods: {\n    getImageUrl: function getImageUrl() {\n      // Usar la propiedad 'image' que sí existe en tus datos\n      if (this.product.image) {\n        return this.product.image;\n      } else {\n        // Usar placeholder de internet en lugar de archivo local\n        return \"https://via.placeholder.com/300x200/cccccc/666666?text=Sin+Imagen\";\n      }\n    },\n    getProductUrl: function getProductUrl() {\n      // Construir URL manualmente porque get_absolute_url no existe en el serializer\n      if (this.canNavigate()) {\n        return \"/product/\".concat(this.product.category_slug, \"/\").concat(this.product.slug);\n      }\n      return \"/\";\n    },\n    canNavigate: function canNavigate() {\n      // Verificar que tenemos todos los datos necesarios para navegar\n      return this.product.slug && this.product.category_slug;\n    },\n    handleImageError: function handleImageError(event) {\n      console.warn(\"Failed to load image:\", event.target.src);\n      // Fallback a placeholder de internet\n      event.target.src = \"https://via.placeholder.com/300x200/cccccc/666666?text=Error+al+cargar\";\n    }\n  }\n};","map":{"version":3,"names":["name","props","product","type","Object","required","methods","getImageUrl","image","getProductUrl","canNavigate","concat","category_slug","slug","handleImageError","event","console","warn","target","src"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/components/ProductBox.vue"],"sourcesContent":["<template>\n  <div class=\"column is-3\">\n    <div class=\"box\">\n      <figure class=\"image mb-4\">\n        <img\n          :src=\"getImageUrl()\"\n          :alt=\"product.name\"\n          @error=\"handleImageError\"\n        />\n      </figure>\n      <h3 class=\"is-size-4\">{{ product.name }}</h3>\n      <p class=\"is-size-6 has-text-grey\">${{ product.price }}</p>\n      <router-link\n        v-bind:to=\"product.get_absolute_url\"\n        class=\"button is-dark mt-4\"\n      >\n        View details\n      </router-link>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ProductBox\",\n  props: {\n    product: {\n      type: Object,\n      required: true,\n    },\n  },\n  methods: {\n    getImageUrl() {\n      // Usar la propiedad 'image' que sí existe en tus datos\n      if (this.product.image) {\n        return this.product.image;\n      } else {\n        // Usar placeholder de internet en lugar de archivo local\n        return \"https://via.placeholder.com/300x200/cccccc/666666?text=Sin+Imagen\";\n      }\n    },\n    getProductUrl() {\n      // Construir URL manualmente porque get_absolute_url no existe en el serializer\n      if (this.canNavigate()) {\n        return `/product/${this.product.category_slug}/${this.product.slug}`;\n      }\n      return \"/\";\n    },\n    canNavigate() {\n      // Verificar que tenemos todos los datos necesarios para navegar\n      return this.product.slug && this.product.category_slug;\n    },\n    handleImageError(event) {\n      console.warn(\"Failed to load image:\", event.target.src);\n      // Fallback a placeholder de internet\n      event.target.src = \"https://via.placeholder.com/300x200/cccccc/666666?text=Error+al+cargar\";\n    },\n  },\n};\n</script>\n\n<style scoped>\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n  object-fit: cover;\n  width: 100%;\n  height: 200px; /* Altura fija para consistencia */\n}\n\n.box {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.hero.is-dark {\n  background-size: cover;\n  background-position: center;\n  position: relative;\n}\n\n.hero.is-dark::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.4);\n}\n\n.hero-body {\n  position: relative;\n  z-index: 1;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .column.is-3 {\n    width: 50%;\n  }\n}\n\n@media (max-width: 480px) {\n  .column.is-3 {\n    width: 100%;\n  }\n}\n</style>"],"mappings":";AAuBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,OAAO,EAAE;MACPC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,WAAW,WAAXA,WAAWA,CAAA,EAAG;MACZ;MACA,IAAI,IAAI,CAACL,OAAO,CAACM,KAAK,EAAE;QACtB,OAAO,IAAI,CAACN,OAAO,CAACM,KAAK;MAC3B,OAAO;QACL;QACA,OAAO,mEAAmE;MAC5E;IACF,CAAC;IACDC,aAAa,WAAbA,aAAaA,CAAA,EAAG;MACd;MACA,IAAI,IAAI,CAACC,WAAW,CAAC,CAAC,EAAE;QACtB,mBAAAC,MAAA,CAAmB,IAAI,CAACT,OAAO,CAACU,aAAa,OAAAD,MAAA,CAAI,IAAI,CAACT,OAAO,CAACW,IAAI;MACpE;MACA,OAAO,GAAG;IACZ,CAAC;IACDH,WAAW,WAAXA,WAAWA,CAAA,EAAG;MACZ;MACA,OAAO,IAAI,CAACR,OAAO,CAACW,IAAG,IAAK,IAAI,CAACX,OAAO,CAACU,aAAa;IACxD,CAAC;IACDE,gBAAgB,WAAhBA,gBAAgBA,CAACC,KAAK,EAAE;MACtBC,OAAO,CAACC,IAAI,CAAC,uBAAuB,EAAEF,KAAK,CAACG,MAAM,CAACC,GAAG,CAAC;MACvD;MACAJ,KAAK,CAACG,MAAM,CAACC,GAAE,GAAI,wEAAwE;IAC7F;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}