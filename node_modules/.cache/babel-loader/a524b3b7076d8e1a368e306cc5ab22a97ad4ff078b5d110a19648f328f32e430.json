{"ast":null,"code":"import \"core-js/modules/es.array.find.js\";\nimport \"core-js/modules/es.function.name.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n// import axios from \"axios\"; // REMOVED\nimport { allProducts } from \"@/data/products.js\"; // IMPORTED\n\nexport default {\n  name: \"ProductView\",\n  data: function data() {\n    return {\n      product: null,\n      // Initialize as null\n      quantity: 1\n    };\n  },\n  mounted: function mounted() {\n    this.getProduct();\n  },\n  watch: {\n    // Si el usuario navega entre productos, esto asegura que la vista se actualice\n    '$route': function $route(to, from) {\n      if (to.name === 'Product') {\n        this.getProduct();\n      }\n    }\n  },\n  methods: {\n    // CHANGED: El método ahora es síncrono y busca en el array local\n    getProduct: function getProduct() {\n      this.$store.commit(\"setLoading\", true);\n      var category_slug = this.$route.params.category_slug;\n      var product_slug = this.$route.params.product_slug;\n\n      // Buscamos el producto en nuestro archivo de datos\n      var foundProduct = allProducts.find(function (p) {\n        return p.category_slug === category_slug && p.slug === product_slug;\n      });\n      if (foundProduct) {\n        this.product = foundProduct;\n        document.title = this.product.name + \" | Finca Samaniego\";\n      } else {\n        console.error(\"Producto no encontrado!\");\n        // Aquí podrías redirigir a una página 404\n      }\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["allProducts","name","data","product","quantity","mounted","getProduct","watch","$route","to","from","methods","$store","commit","category_slug","params","product_slug","foundProduct","find","p","slug","document","title","console","error"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/views/ProductView.vue"],"sourcesContent":["<template>\n  <div class=\"product-view\" v-if=\"product\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-6\">\n        <figure class=\"image product-image\">\n          <img\n            v-if=\"product.image_url\"\n            :src=\"product.image_url\"\n            alt=\"Product Image\"\n          />\n        </figure>\n      </div>\n\n      <div class=\"column is-6\">\n        <h1 class=\"title\">{{ product.name }}</h1>\n        <p class=\"subtitle is-5\">{{ product.description }}</p>\n\n        <hr />\n\n        <h2 class=\"subtitle is-4\">Detalles</h2>\n        <p><strong>Precio:</strong> ${{ product.price }}</p>\n\n        <div class=\"field has-addons mt-6\">\n          <div class=\"control\">\n            <input type=\"number\" class=\"input\" v-model=\"quantity\" min=\"1\" />\n          </div>\n\n          <div class=\"control\">\n            <a class=\"button is-success\">Añadir al carrito</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div v-else>\n     <h1 class=\"title has-text-centered\">Producto no encontrado</h1>\n  </div>\n</template>\n\n<script>\n// import axios from \"axios\"; // REMOVED\nimport { allProducts } from \"@/data/products.js\"; // IMPORTED\n\nexport default {\n  name: \"ProductView\",\n  data() {\n    return {\n      product: null, // Initialize as null\n      quantity: 1,\n    };\n  },\n  mounted() {\n    this.getProduct();\n  },\n  watch: {\n    // Si el usuario navega entre productos, esto asegura que la vista se actualice\n    '$route'(to, from) {\n      if (to.name === 'Product') {\n        this.getProduct();\n      }\n    }\n  },\n  methods: {\n    // CHANGED: El método ahora es síncrono y busca en el array local\n    getProduct() {\n      this.$store.commit(\"setLoading\", true);\n      \n      const category_slug = this.$route.params.category_slug;\n      const product_slug = this.$route.params.product_slug;\n\n      // Buscamos el producto en nuestro archivo de datos\n      const foundProduct = allProducts.find(p => p.category_slug === category_slug && p.slug === product_slug);\n\n      if (foundProduct) {\n        this.product = foundProduct;\n        document.title = this.product.name + \" | Finca Samaniego\";\n      } else {\n        console.error(\"Producto no encontrado!\");\n        // Aquí podrías redirigir a una página 404\n      }\n      \n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>\n\n<style>\n.product-image img {\n  width: 600px;\n  height: 600px;\n  object-fit: cover;\n  display: block;\n  margin: 0 auto;\n}\n</style>"],"mappings":";;;;;AAwCA;AACA,SAASA,WAAU,QAAS,oBAAoB,EAAE;;AAElD,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,IAAI;MAAE;MACfC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAO,WAAPA,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,UAAU,CAAC,CAAC;EACnB,CAAC;EACDC,KAAK,EAAE;IACL;IACA,QAAQ,WAARC,MAAQA,CAACC,EAAE,EAAEC,IAAI,EAAE;MACjB,IAAID,EAAE,CAACR,IAAG,KAAM,SAAS,EAAE;QACzB,IAAI,CAACK,UAAU,CAAC,CAAC;MACnB;IACF;EACF,CAAC;EACDK,OAAO,EAAE;IACP;IACAL,UAAU,WAAVA,UAAUA,CAAA,EAAG;MACX,IAAI,CAACM,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,IAAI,CAAC;MAEtC,IAAMC,aAAY,GAAI,IAAI,CAACN,MAAM,CAACO,MAAM,CAACD,aAAa;MACtD,IAAME,YAAW,GAAI,IAAI,CAACR,MAAM,CAACO,MAAM,CAACC,YAAY;;MAEpD;MACA,IAAMC,YAAW,GAAIjB,WAAW,CAACkB,IAAI,CAAC,UAAAC,CAAA;QAAA,OAAKA,CAAC,CAACL,aAAY,KAAMA,aAAY,IAAKK,CAAC,CAACC,IAAG,KAAMJ,YAAY;MAAA,EAAC;MAExG,IAAIC,YAAY,EAAE;QAChB,IAAI,CAACd,OAAM,GAAIc,YAAY;QAC3BI,QAAQ,CAACC,KAAI,GAAI,IAAI,CAACnB,OAAO,CAACF,IAAG,GAAI,oBAAoB;MAC3D,OAAO;QACLsB,OAAO,CAACC,KAAK,CAAC,yBAAyB,CAAC;QACxC;MACF;MAEA,IAAI,CAACZ,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,KAAK,CAAC;IACzC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}