{"ast":null,"code":"import \"core-js/modules/es.array.filter.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport ProductBox from \"@/components/ProductBox.vue\";\nimport { allProducts } from \"@/data/products.js\"; // IMPORTED: La única fuente de datos\n\nexport default {\n  name: \"CategoryView\",\n  components: {\n    ProductBox: ProductBox\n  },\n  computed: {\n    category_slug: function category_slug() {\n      return this.$route.params.category_slug;\n    },\n    category: function category() {\n      var _this = this;\n      this.$store.commit(\"setLoading\", true);\n      var filteredProducts = allProducts.filter(function (p) {\n        return p.category_slug === _this.category_slug;\n      });\n      var categoryName = filteredProducts.length > 0 ? filteredProducts[0].category_name : 'Categoría no encontrada';\n      if (filteredProducts.length > 0) {\n        document.title = categoryName + ' | Finca Samaniego';\n      }\n      this.$store.commit(\"setLoading\", false);\n      return {\n        products: filteredProducts,\n        name: categoryName\n      };\n    }\n  }\n};","map":{"version":3,"names":["ProductBox","allProducts","name","components","computed","category_slug","$route","params","category","_this","$store","commit","filteredProducts","filter","p","categoryName","length","category_name","document","title","products"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/views/CategoryView.vue"],"sourcesContent":["<template>\n  <div class=\"page-category\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered\">{{ category.name }}</h2>\n      </div>\n      <ProductBox\n        v-for=\"product in category.products\"\n        :key=\"product.id\"\n        :product=\"product\"\n      />\n    </div>\n  </div>\n</template>\n\n<script>\nimpo