{"ast":null,"code":"export default {\n  data: function data() {\n    return {\n      showMobileMenu: false\n    };\n  },\n  methods: {\n    // Método helper para cerrar el menú móvil al navegar\n    closeMenu: function closeMenu() {\n      this.showMobileMenu = false;\n    }\n  },\n  watch: {\n    // Cerrar menú automáticamente al cambiar de ruta\n    '$route': function $route() {\n      this.showMobileMenu = false;\n    }\n  }\n};","map":{"version":3,"names":["data","showMobileMenu","methods","closeMenu","watch","$route"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"wrapper\">\n    <header>\n      <nav class=\"navbar is-dark\">\n        <div class=\"navbar-brand\">\n          <router-link to=\"/\" class=\"navbar-item\">\n            <img src=\"@/assets/finca_sama.png\" alt=\"Finca Samaniego Logo\" />\n          </router-link>\n          <span\n            class=\"navbar-item is-align-items-center\"\n            style=\"display: flex; align-items: center\"\n          >\n            <strong>Finca Samaniego</strong>\n          </span>\n          <a\n            class=\"navbar-burger\"\n            aria-label=\"menu\"\n            aria-expanded=\"false\"\n            data-target=\"navbar-menu\"\n            @click=\"showMobileMenu = !showMobileMenu\"\n          >\n            <span aria-hidden=\"true\"></span>\n            <span aria-hidden=\"true\"></span>\n            <span aria-hidden=\"true\"></span>\n            <span aria-hidden=\"true\"></span>\n          </a>\n        </div>\n        <div\n          class=\"navbar-menu\"\n          id=\"navbar-menu\"\n          v-bind:class=\"{ 'is-active': showMobileMenu }\"\n        >\n          <router-link to=\"/\" class=\"navbar-item\">Inicio</router-link>\n          <router-link to=\"/about\" class=\"navbar-item\">Nosotros</router-link>\n          \n          <!-- Dropdown para productos -->\n          <div class=\"navbar-item has-dropdown is-hoverable\">\n            <a class=\"navbar-link\">\n              Productos\n            </a>\n            <div class=\"navbar-dropdown\">\n              <!-- Cambia estos enlaces por la estructura correcta -->\n              <router-link \n                to=\"/category/salsas\" \n                class=\"navbar-item\"\n              >\n                Salsa Chiltepin\n              </router-link>\n              <router-link \n                to=\"/category/chiltepin\" \n                class=\"navbar-item\"\n              >\n                Chiltepin Entero\n              </router-link>\n            </div>\n          </div>\n          \n          <router-link to=\"/contact\" class=\"navbar-item\">Contacto</router-link>\n        </div>\n      </nav>\n      \n      <div\n        class=\"is-loading-bar has-text-centered\"\n        v-bind:class=\"{ 'is-loading': $store.state.isLoading }\"\n      >\n        <div class=\"lds-dual-ring\"></div>\n      </div>\n      \n      <section class=\"section\">\n        <router-view />\n      </section>\n      \n      <footer class=\"footer\">\n        <p class=\"content has-text-centered\">\n          Finca Samaniego Copyright (c) 2025\n        </p>\n      </footer>\n    </header>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      showMobileMenu: false,\n    };\n  },\n  \n  methods: {\n    // Método helper para cerrar el menú móvil al navegar\n    closeMenu() {\n      this.showMobileMenu = false;\n    }\n  },\n  \n  watch: {\n    // Cerrar menú automáticamente al cambiar de ruta\n    '$route'() {\n      this.showMobileMenu = false;\n    }\n  }\n};\n</script>\n\n<style lang=\"scss\">\n@import \"../node_modules/bulma/\";\n\n.lds-dual-ring {\n  display: inline-block;\n  width: 80px;\n  height: 80px;\n  position: relative;\n  border-radius: 50%;\n  box-shadow: 0 0 20px #3498db55, 0 0 40px #00c3ff33;\n}\n\n.lds-dual-ring:after {\n  content: \" \";\n  display: block;\n  width: 64px;\n  height: 64px;\n  margin: 8px;\n  border-radius: 50%;\n  border: 8px solid transparent;\n  border-top: 8px solid #888888;\n  border-right: 8px solid #bbbbbb;\n  border-bottom: 8px solid #dddddd;\n  border-left: 8px solid #f3f3f3;\n  animation: lds-dual-ring 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;\n  box-shadow: 0 0 30px #88888844;\n}\n\n@keyframes lds-dual-ring {\n  0% {\n    transform: rotate(0deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n  50% {\n    transform: rotate(180deg) scale(1.1);\n    box-shadow: 0 0 50px #00e6d088;\n  }\n  100% {\n    transform: rotate(360deg) scale(1);\n    box-shadow: 0 0 30px #00c3ff88;\n  }\n}\n\n.is-loading-bar {\n  height: 0;\n  overflow: hidden;\n  -webkit-transition: all 0.3s ease-in-out;\n  transition: all 0.3s ease-in-out;\n\n  &.is-loading {\n    height: 80px;\n  }\n}\n</style>"],"mappings":"AAkFA,eAAe;EACbA,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EAEDC,OAAO,EAAE;IACP;IACAC,SAAS,WAATA,SAASA,CAAA,EAAG;MACV,IAAI,CAACF,cAAa,GAAI,KAAK;IAC7B;EACF,CAAC;EAEDG,KAAK,EAAE;IACL;IACA,QAAQ,WAARC,MAAQA,CAAA,EAAG;MACT,IAAI,CAACJ,cAAa,GAAI,KAAK;IAC7B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}