{"ast":null,"code":"import axios from \"axios\";\nimport { toast } from \"bulma-toast\";\nimport ProductBox from \"@/components/ProductBox.vue\";\nexport default {\n  name: \"CategoryView\",\n  data() {\n    return {\n      category: {\n        products: []\n      }\n    };\n  },\n  components: {\n    ProductBox\n  },\n  mounted() {\n    this.getCategory();\n  },\n  methods: {\n    async getCategory() {\n      const category_slug = this.$route.params.category_slug;\n      this.$store.commit(\"setLoading\", true);\n      await axios.get(`api/product/${category_slug}/`).then(response => {\n        this.category = response.data;\n        document.title = this.category.name + \" | Finca Samaniego\"; // Set the page title\n      }).catch(error => {\n        console.error(\"Error fetching category:\", error);\n        toast({\n          message: \"Error al cargar la categoría\",\n          type: \"is-danger\",\n          dismissible: true,\n          pauseOnHover: true,\n          duration: 2000\n        });\n      });\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["axios","toast","ProductBox","name","data","category","products","components","mounted","getCategory","methods","category_slug","$route","params","$store","commit","get","then","response","document","title","catch","error","console","message","type","dismissible","pauseOnHover","duration"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/CategoryView.vue"],"sourcesContent":["<template>\n  <div class=\"page-category\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered\">{{ category.name }}</h2>\n      </div>\n      <ProductBox\n        v-for=\"product in category.products\"\n        :key=\"product.id\"\n        :product=\"product\"\n      />\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport { toast } from \"bulma-toast\";\nimport ProductBox from \"@/components/ProductBox.vue\";\nexport default {\n  name: \"CategoryView\",\n  data() {\n    return {\n      category: {\n        products: [],\n      },\n    };\n  },\n  components: {\n    ProductBox,\n  },\n  mounted() {\n    this.getCategory();\n  },\n  methods: {\n    async getCategory() {\n      const category_slug = this.$route.params.category_slug;\n      this.$store.commit(\"setLoading\", true);\n      await axios\n        .get(`api/product/${category_slug}/`)\n        .then((response) => {\n          this.category = response.data;\n          document.title = this.category.name + \" | Finca Samaniego\"; // Set the page title\n        })\n        .catch((error) => {\n          console.error(\"Error fetching category:\", error);\n          toast({\n            message: \"Error al cargar la categoría\",\n            type: \"is-danger\",\n            dismissible: true,\n            pauseOnHover: true,\n            duration: 2000,\n          });\n        });\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>\n"],"mappings":"AAgBA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,KAAI,QAAS,aAAa;AACnC,OAAOC,UAAS,MAAO,6BAA6B;AACpD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;QACRC,QAAQ,EAAE;MACZ;IACF,CAAC;EACH,CAAC;EACDC,UAAU,EAAE;IACVL;EACF,CAAC;EACDM,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,WAAW,CAAC,CAAC;EACpB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,WAAWA,CAAA,EAAG;MAClB,MAAME,aAAY,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACF,aAAa;MACtD,IAAI,CAACG,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,IAAI,CAAC;MACtC,MAAMf,KAAI,CACPgB,GAAG,CAAC,eAAeL,aAAa,GAAG,EACnCM,IAAI,CAAEC,QAAQ,IAAK;QAClB,IAAI,CAACb,QAAO,GAAIa,QAAQ,CAACd,IAAI;QAC7Be,QAAQ,CAACC,KAAI,GAAI,IAAI,CAACf,QAAQ,CAACF,IAAG,GAAI,oBAAoB,EAAE;MAC9D,CAAC,EACAkB,KAAK,CAAEC,KAAK,IAAK;QAChBC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK,CAAC;QAChDrB,KAAK,CAAC;UACJuB,OAAO,EAAE,8BAA8B;UACvCC,IAAI,EAAE,WAAW;UACjBC,WAAW,EAAE,IAAI;UACjBC,YAAY,EAAE,IAAI;UAClBC,QAAQ,EAAE;QACZ,CAAC,CAAC