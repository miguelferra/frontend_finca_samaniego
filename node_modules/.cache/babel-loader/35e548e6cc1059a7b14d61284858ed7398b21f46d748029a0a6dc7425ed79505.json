{"ast":null,"code":"import axios from \"axios\";\nimport { toast } from 'bulma-toast';\nimport ProductBox from '@/components/ProductBox.vue'; // <-- 1. Importa el componente\n\nexport default {\n  name: \"CategoryView\",\n  components: {\n    ProductBox // <-- 2. Registra el componente para poder usarlo\n  },\n  data() {\n    return {\n      category: {\n        products: []\n      }\n    };\n  },\n  mounted() {\n    this.getCategory();\n  },\n  watch: {\n    // Si el usuario navega de una categoría a otra, este \"watcher\" detecta\n    // el cambio en la URL y vuelve a llamar a la API.\n    $route(to, from) {\n      if (to.name === 'Category') {\n        this.getCategory();\n      }\n    }\n  },\n  methods: {\n    async getCategory() {\n      const category_slug = this.$route.params.category_slug;\n      this.$store.commit(\"setLoading\", true);\n      await axios.get(`/api/v1/products/${category_slug}/`) // <-- Corregí la URL por consistencia\n      .then(response => {\n        this.category = response.data;\n        document.title = this.category.name + ' | Finca Samaniego';\n      }).catch(error => {\n        console.error(\"Error fetching category:\", error);\n        toast({\n          message: \"Error al cargar la categoría. Algo salió mal.\",\n          type: \"is-danger\",\n          dismissible: true,\n          pauseOnHover: true,\n          duration: 2000\n        });\n      });\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["axios","toast","ProductBox","name","components","data","category","products","mounted","getCategory","watch","$route","to","from","methods","category_slug","params","$store","commit","get","then","response","document","title","catch","error","console","message","type","dismissible","pauseOnHover","duration"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/CategoryView.vue"],"sourcesContent":["<template>\n  <div class=\"page-category\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered\">{{ category.name }}</h2>\n      </div>\n\n      <ProductBox \n        v-for=\"product in category.products\"\n        v-bind:key=\"product.id\"\n        v-bind:product=\"product\" />\n      </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport { toast } from 'bulma-toast';\nimport ProductBox from '@/components/ProductBox.vue'; // <-- 1. Importa el componente\n\nexport default {\n  name: \"CategoryView\",\n  components: {\n    ProductBox // <-- 2. Registra el componente para poder usarlo\n  },\n  data() {\n    return {\n      category: {\n        products: [],\n      },\n    };\n  },\n  mounted() {\n    this.getCategory();\n  },\n  watch: {\n    // Si el usuario navega de una categoría a otra, este \"watcher\" detecta\n    // el cambio en la URL y vuelve a llamar a la API.\n    $route(to, from) {\n      if (to.name === 'Category') {\n        this.getCategory()\n      }\n    }\n  },\n  methods: {\n    async getCategory() {\n      const category_slug = this.$route.params.category_slug;\n      \n      this.$store.commit(\"setLoading\", true);\n      \n      await axios\n        .get(`/api/v1/products/${category_slug}/`) // <-- Corregí la URL por consistencia\n        .then((response) => {\n          this.category = response.data;\n          document.title = this.category.name + ' | Finca Samaniego';\n        })\n        .catch((error) => {\n          console.error(\"Error fetching category:\", error);\n          toast({\n            message: \"Error al cargar la categoría. Algo salió mal.\",\n            type: \"is-danger\",\n            dismissible: true,\n            pauseOnHover: true,\n            duration: 2000,\n          });\n        });\n\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>"],"mappings":"AAgBA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,KAAI,QAAS,aAAa;AACnC,OAAOC,UAAS,MAAO,6BA