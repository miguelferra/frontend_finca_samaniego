{"ast":null,"code":"import \"core-js/modules/es.array.sort.js\";\nimport \"core-js/modules/es.date.to-string.js\";\n// import axios from \"axios\"; // REMOVED\nimport ProductBox from \"@/components/ProductBox.vue\";\nimport { allProducts } from \"@/data/products.js\"; // IMPORTED: nuestra nueva fuente de datos\n\nexport default {\n  name: \"HomeView\",\n  data: function data() {\n    return {\n      imageUrl: '/background.jpg',\n      // CHANGED: Cargamos los datos directamente\n      latestProducts: []\n    };\n  },\n  components: {\n    ProductBox: ProductBox\n  },\n  mounted: function mounted() {\n    // CHANGED: Obtenemos los productos de nuestro archivo local\n    // Puedes ordenar por fecha si quieres los \"más recientes\"\n    this.latestProducts = allProducts.sort(function (a, b) {\n      return new Date(b.date_added) - new Date(a.date_added);\n    });\n    document.title = 'Bienvenidos | Finca Samaniego';\n  } // REMOVED: El método getLatestProducts ya no es necesario\n  // methods: {\n  //   async getLatestProducts() { ... }\n  // }\n};","map":{"version":3,"names":["ProductBox","allProducts","name","data","imageUrl","latestProducts","components","mounted","sort","a","b","Date","date_added","document","title"],"sources":["/home/ferra/Documents/PROJECTS/frontend_finca_samaniego/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <section\n      class=\"hero is-medium is-dark mb-6\"\n      :style=\"{ backgroundImage: 'url(' + imageUrl + ')' }\"\n    >\n      <div class=\"hero-body has-text-centered\">\n        <div class=\"container\">\n          <h1 class=\"title\">Bienvenido a Finca Samaniego</h1>\n          <h2 class=\"subtitle\">\n            Descubre nuestros productos frescos y orgánicos.\n          </h2>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered mb-4\">Productos Recientes</h2>\n      </div>\n      <ProductBox\n        v-for=\"product in latestProducts\"\n        :key=\"product.id\"\n        :product=\"product\"\n      />\n    </div>\n  </div>\n</template>\n\n<script>\n// import axios from \"axios\"; // REMOVED\nimport ProductBox from \"@/components/ProductBox.vue\";\nimport { allProducts } from \"@/data/products.js\"; // IMPORTED: nuestra nueva fuente de datos\n\nexport default {\n  name: \"HomeView\",\n  data() {\n    return {\n      imageUrl: '/background.jpg',\n      // CHANGED: Cargamos los datos directamente\n      latestProducts: [],\n    };\n  },\n  components: {\n    ProductBox\n  },\n  mounted() {\n    // CHANGED: Obtenemos los productos de nuestro archivo local\n    // Puedes ordenar por fecha si quieres los \"más recientes\"\n    this.latestProducts = allProducts.sort((a, b) => new Date(b.date_added) - new Date(a.date_added));\n    document.title = 'Bienvenidos | Finca Samaniego';\n  },\n  // REMOVED: El método getLatestProducts ya no es necesario\n  // methods: {\n  //   async getLatestProducts() { ... }\n  // }\n};\n</script>"],"mappings":";;AA8BA;AACA,OAAOA,UAAS,MAAO,6BAA6B;AACpD,SAASC,WAAU,QAAS,oBAAoB,EAAE;;AAElD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,iBAAiB;MAC3B;MACAC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,UAAU,EAAE;IACVN,UAAS,EAATA;EACF,CAAC;EACDO,OAAO,WAAPA,OAAOA,CAAA,EAAG;IACR;IACA;IACA,IAAI,CAACF,cAAa,GAAIJ,WAAW,CAACO,IAAI,CAAC,UAACC,CAAC,EAAEC,CAAC;MAAA,OAAK,IAAIC,IAAI,CAACD,CAAC,CAACE,UAAU,IAAI,IAAID,IAAI,CAACF,CAAC,CAACG,UAAU,CAAC;IAAA,EAAC;IACjGC,QAAQ,CAACC,KAAI,GAAI,+BAA+B;EAClD,CAAC,CACD;EACA;EACA;EACA;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}