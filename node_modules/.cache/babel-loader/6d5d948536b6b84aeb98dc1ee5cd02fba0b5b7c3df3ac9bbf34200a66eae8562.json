{"ast":null,"code":"import axios from \"axios\";\nimport ProductBox from \"@/components/ProductBox.vue\";\nexport default {\n  name: \"HomeView\",\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: \"/background.jpg\"\n    };\n  },\n  components: {\n    ProductBox\n  },\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    async getLatestProducts() {\n      this.$store.commit(\"setLoading\", true);\n      await axios.get(\"api/latest/\").then(response => {\n        this.latestProducts = response.data;\n        document.title = 'Bienvenidos | Finca Samaniego'; // Set the page title\n      }).catch(error => {\n        console.error(\"Error fetching latest products:\", error);\n      });\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["axios","ProductBox","name","data","latestProducts","imageUrl","components","mounted","getLatestProducts","methods","$store","commit","get","then","response","document","title","catch","error","console"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <section\n      class=\"hero is-medium is-dark mb-6\"\n      :style=\"{ backgroundImage: 'url(' + imageUrl + ')' }\"\n    >\n      <div class=\"hero-body has-text-centered\">\n        <div class=\"container\">\n          <h1 class=\"title\">Bienvenido a Finca Samaniego</h1>\n          <h2 class=\"subtitle\">\n            Descubre nuestros productos frescos y orgánicos.\n          </h2>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered mb-4\">Products</h2>\n      </div>\n     <ProductBox\n        v-for=\"product in latestProducts\"\n        :key=\"product.id\"\n        :product=\"product\"\n      />\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport ProductBox from \"@/components/ProductBox.vue\";\nexport default {\n  name: \"HomeView\",\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: \"/background.jpg\",\n    };\n  },\n  components: {\n    ProductBox\n  },\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    async getLatestProducts() {\n      this.$store.commit(\"setLoading\", true);\n      await axios\n        .get(\"api/latest/\")\n        .then((response) => {\n          this.latestProducts = response.data;\n          document.title = 'Bienvenidos | Finca Samaniego'; // Set the page title\n        })\n        .catch((error) => {\n          console.error(\"Error fetching latest products:\", error);\n        });\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>\n\n"],"mappings":"AA8BA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,UAAS,MAAO,6BAA6B;AACpD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,EAAE;MAClB;MACAC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,UAAU,EAAE;IACVL;EACF,CAAC;EACDM,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,iBAAiBA,CAAA,EAAG;MACxB,IAAI,CAACE,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,IAAI,CAAC;MACtC,MAAMX,KAAI,CACPY,GAAG,CAAC,aAAa,EACjBC,IAAI,CAAEC,QAAQ,IAAK;QAClB,IAAI,CAACV,cAAa,GAAIU,QAAQ,CAACX,IAAI;QACnCY,QAAQ,CAACC,KAAI,GAAI,+BAA+B,EAAE;MACpD,CAAC,EACAC,KAAK,CAAEC,KAAK,IAAK;QAChBC,OAAO,CAACD,KAAK,CAAC,iCAAiC,EAAEA,KAAK,CAAC;MACzD,CAAC,CAAC;MACJ,IAAI,CAACR,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,KAAK,CAAC;IACzC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}