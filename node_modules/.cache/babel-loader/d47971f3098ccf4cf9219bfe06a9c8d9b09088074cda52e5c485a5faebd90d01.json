ct\" />\n      </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport { toast } from 'bulma-toast';\nimport ProductBox from '@/components/ProductBox.vue'; // <-- 1. Importa el componente\n\nexport default {\n  name: \"CategoryView\",\n  components: {\n    ProductBox // <-- 2. Registra el componente para poder usarlo\n  },\n  data() {\n    return {\n      category: {\n        products: [],\n      },\n    };\n  },\n  mounted() {\n    this.getCategory();\n  },\n  watch: {\n    // Si el usuario navega de una categoría a otra, este \"watcher\" detecta\n    // el cambio en la URL y vuelve a llamar a la API.\n    $route(to, from) {\n      if (to.name === 'Category') {\n        this.getCategory()\n      }\n    }\n  },\n  methods: {\n    async getCategory() {\n      const category_slug = this.$route.params.category_slug;\n      \n      this.$store.commit(\"setLoading\", true);\n      \n      await axios\n        .get(`/api/v1/products/${category_slug}/`) // <-- Corregí la URL por consistencia\n        .then((response) => {\n          this.category = response.data;\n          document.title = this.category.name + ' | Finca Samaniego';\n        })\n        .catch((error) => {\n          console.error(\"Error fetching category:\", error);\n          toast({\n            message: \"Error al cargar la categoría. Algo salió mal.\",\n            type: \"is-danger\",\n            dismissible: true,\n            pauseOnHover: true,\n            duration: 2000,\n          });\n        });\n\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>"],"mappings":";;EACOA,KAAK,EAAC;AAAe;;EACnBA,KAAK,EAAC;AAAsB;;EAC1BA,KAAK,EAAC;AAAc;;EACnBA,KAAK,EAAC;AAA6B;;;uBAH7CC,mBAAA,CAWM,OAXNC,UAWM,GAVJC,mBAAA,CASQ,OATRC,UASQ,GARND,mBAAA,CAEM,OAFNE,UAEM,GADJF,mBAAA,CAAgE,MAAhEG,UAAgE,EAAAC,gBAAA,CAArBC,KAAA,CAAAC,QAAQ,CAACC,IAAI,iB,sBAG1DT,mBAAA,CAG6BU,SAAA,QAAAC,WAAA,CAFTJ,KAAA,CAAAC,QAAQ,CAACI,QAAQ,EAA5BC,OAAO;yBADhBC,YAAA,CAG6BC,qBAAA;MADpBC,GAAG,EAA