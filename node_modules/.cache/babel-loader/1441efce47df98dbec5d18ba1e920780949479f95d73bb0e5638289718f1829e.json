{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  name: \"ProductView\",\n  data() {\n    return {\n      product: {},\n      quantity: 1\n    };\n  },\n  mounted() {\n    this.getProduct();\n  },\n  methods: {\n    async getProduct() {\n      this.$store.commit(\"setLoading\", true);\n      const category_slug = this.$route.params.category_slug;\n      const product_slug = this.$route.params.product_slug;\n      await axios.get(`api/product/${category_slug}/${product_slug}/`).then(response => {\n        this.product = response.data;\n        document.title = this.product.name; // Set the page title\n      }).catch(error => {\n        console.error(\"Error fetching product:\", error);\n      });\n      this.$store.commit(\"setLoading\", false);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","product","quantity","mounted","getProduct","methods","$store","commit","category_slug","$route","params","product_slug","get","then","response","document","title","catch","error","console"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/ProductView.vue"],"sourcesContent":["<template>\n  <div class=\"product-view\">\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-6\">\n        <figure class=\"image product-image\">\n          <img\n            v-if=\"product.get_image\"\n            :src=\"product.get_image\"\n            alt=\"Product Image\"\n          />\n        </figure>\n      </div>\n\n      <div class=\"column is-6\">\n        <h1 class=\"title\">{{ product.name }}</h1>\n        <p class=\"subtitle is-5\">{{ product.description }}</p>\n\n        <hr />\n\n        <h2 class=\"subtitle is-4\">Detalles</h2>\n        <p><strong>Precio:</strong> ${{ product.price }}</p>\n\n        <div class=\"field has-addons mt-6\">\n          <div class=\"control\">\n            <input type=\"number\" class=\"input\" v-model=\"quantity\" min=\"1\" />\n          </div>\n\n          <div class=\"control\">\n            <a class=\"button is-success\">Añadir al carrito</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nexport default {\n  name: \"ProductView\",\n  data() {\n    return {\n      product: {},\n      quantity: 1,\n    };\n  },\n  mounted() {\n    this.getProduct();\n  },\n  methods: {\n    async getProduct() {\n      this.$store.commit(\"setLoading\", true);\n      const category_slug = this.$route.params.category_slug;\n      const product_slug = this.$route.params.product_slug;\n      await axios\n        .get(`api/product/${category_slug}/${product_slug}/`)\n        .then((response) => {\n          this.product = response.data;\n          document.title = this.product.name; // Set the page title\n        })\n        .catch((error) => {\n          console.error(\"Error fetching product:\", error);\n        });\n      this.$store.commit(\"setLoading\", false);\n    },\n  },\n};\n</script>\n\n<style>\n.product-image img {\n  width: 600px; /* Set your desired width */\n  height: 600px; /* Set your desired height */\n  object-fit: cover;\n  display: block;\n  margin: 0 auto;\n}\n</style>\n"],"mappings":"AAqCA,OAAOA,KAAI,MAAO,OAAO;AACzB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,CAAC,CAAC;MACXC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,UAAU,CAAC,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,UAAUA,CAAA,EAAG;MACjB,IAAI,CAACE,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,IAAI,CAAC;MACtC,MAAMC,aAAY,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACF,aAAa;MACtD,MAAMG,YAAW,GAAI,IAAI,CAACF,MAAM,CAACC,MAAM,CAACC,YAAY;MACpD,MAAMb,KAAI,CACPc,GAAG,CAAC,eAAeJ,aAAa,IAAIG,YAAY,GAAG,EACnDE,IAAI,CAAEC,QAAQ,IAAK;QAClB,IAAI,CAACb,OAAM,GAAIa,QAAQ,CAACd,IAAI;QAC5Be,QAAQ,CAACC,KAAI,GAAI,IAAI,CAACf,OAAO,CAACF,IAAI,EAAE;MACtC,CAAC,EACAkB,KAAK,CAAEC,KAAK,IAAK;QAChBC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;MACjD,CAAC,CAAC;MACJ,IAAI,CAACZ,MAAM,CAACC,MAAM,CAAC,YAAY,EAAE,KAAK,CAAC;IACzC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}