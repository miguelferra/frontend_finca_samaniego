{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: '/background.jpg'\n    };\n  },\n  components: {},\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    getLatestProducts() {\n      axios.get('api/latest/').then(response => {\n        this.latestProducts = response.data;\n      }).catch(error => {\n        console.error('Error fetching latest products:', error);\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","latestProducts","imageUrl","components","mounted","getLatestProducts","methods","get","then","response","catch","error","console"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <section \n      class=\"hero is-medium is-dark mb-6\"\n      :style=\"{ backgroundImage: 'url(' + imageUrl + ')' }\"\n    >\n      <div class=\"hero-body has-text-centered\">\n        <div class=\"container\">\n          <h1 class=\"title\">Bienvenido a Finca Samaniego</h1>\n          <h2 class=\"subtitle\">\n            Descubre nuestros productos frescos y orgánicos.\n          </h2>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"columns is-multiline\">\n      <div class=\"column is-12\">\n        <h2 class=\"is-size-2 has-text-centered mb-4\">\n         Products\n        </h2>\n      </div>\n      <div\n        class=\"column is-3\"\n        v-for=\"product in latestProducts\"\n        :key=\"product.id\"\n      >\n        <div class=\"box\">\n          <figure class=\"image mb-4\">\n            <img :src=\"product.get_thumbnail\" alt=\"Product Image\" />\n          </figure>\n          <h3 class=\"title is-4\">{{ product.name }}</h3>\n          <p class=\"subtitle is-6 has-text-grey\">${{ product.price }}</p>\n          View Details\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      latestProducts: [],\n      // 2. Se añade la ruta de la imagen a los datos\n      imageUrl: '/background.jpg' \n    };\n  },\n  components: {},\n  mounted() {\n    this.getLatestProducts();\n  },\n  methods: {\n    getLatestProducts() {\n      axios.get('api/latest/')\n        .then(response => {\n          this.latestProducts = response.data;\n        })\n        .catch(error => {\n          console.error('Error fetching latest products:', error);\n        });\n    },\n  },\n};\n</script>\n\n<style scoped>\n/* 3. Se elimina el código del fondo de aquí */\n.image img {\n  margin-top: -1.25rem;\n  margin-bottom: 0rem;\n  margin-right: -1.25rem;\n}\n\n.hero.is-dark {\n  background-size: cover;\n  background-position: center;\n  position: relative;\n}\n\n/* Opcional: puedes dejar un overlay oscuro si quieres */\n.hero.is-dark::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.4); /* Overlay oscuro */\n}\n\n/* El hero-body necesita estar por encima del overlay */\n.hero-body {\n  position: relative;\n  z-index: 1;\n}\n</style>"],"mappings":"AAyCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,EAAE;MAClB;MACAC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,UAAU,EAAE,CAAC,CAAC;EACdC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACPD,iBAAiBA,CAAA,EAAG;MAClBP,KAAK,CAACS,GAAG,CAAC,aAAa,EACpBC,IAAI,CAACC,QAAO,IAAK;QAChB,IAAI,CAACR,cAAa,GAAIQ,QAAQ,CAACT,IAAI;MACrC,CAAC,EACAU,KAAK,CAACC,KAAI,IAAK;QACdC,OAAO,CAACD,KAAK,CAAC,iCAAiC,EAAEA,KAAK,CAAC;MACzD,CAAC,CAAC;IACN;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}