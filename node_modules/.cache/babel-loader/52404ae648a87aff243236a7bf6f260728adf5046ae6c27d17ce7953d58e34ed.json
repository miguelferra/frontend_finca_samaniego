{"ast":null,"code":"import { ref } from 'vue';\n\n// Reactive state for tracking if the mobile menu is open or closed.\n\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const isMenuOpen = ref(false);\n\n    // Function to toggle the menu's state.\n    const toggleMenu = () => {\n      isMenuOpen.value = !isMenuOpen.value;\n    };\n    const __returned__ = {\n      isMenuOpen,\n      toggleMenu,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","isMenuOpen","toggleMenu","value"],"sources":["/home/ferra/Documents/PROJECTS/fincaSamaniegoBackend/frontend_finca_samaniego/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"wrapper\">\n    <header>\n      <!-- The 'is-dark' class gives the navbar a dark theme. -->\n      <nav class=\"navbar is-dark\" role=\"navigation\" aria-label=\"main navigation\">\n        <div class=\"navbar-brand\">\n          <!-- Logo and Brand Name -->\n          <a class=\"navbar-item\" href=\"/\">\n            <!-- It's a good practice to set a width on the logo for consistency -->\n            <img src=\"@/assets/finca_sama.png\" alt=\"Finca Samaniego Logo\" width=\"112\" height=\"28\">\n          </a>\n          <span class=\"navbar-item is-align-items-center\" style=\"display: flex; align-items: center;\">\n            <strong>Finca Samaniego</strong>\n          </span>\n\n          <!-- \n            Hamburger Menu Button\n            - This 'a' tag is the hamburger icon that shows up on touch devices.\n            - The 'is-active' class is toggled by the 'isMenuOpen' data property.\n            - The @click event calls the 'toggleMenu' method.\n            - ARIA attributes are included for accessibility.\n          -->\n          <a\n            role=\"button\"\n            class=\"navbar-burger\"\n            :class=\"{ 'is-active': isMenuOpen }\"\n            aria-label=\"menu\"\n            :aria-expanded=\"isMenuOpen\"\n            @click=\"toggleMenu\"\n          >\n            <span aria-hidden=\"true\"></span>\n            <span aria-hidden=\"true\"></span>\n            <span aria-hidden=\"true\"></span>\n          </a>\n        </div>\n\n        <!-- \n          Navigation Menu\n          - The 'is-active' class is toggled by the 'isMenuOpen' data property.\n            This class makes the menu visible on mobile when the hamburger is clicked.\n        -->\n        <div class=\"navbar-menu\" :class=\"{ 'is-active': isMenuOpen }\">\n          <div class=\"navbar-end\">\n            <a class=\"navbar-item\" href=\"/\">Inicio</a>\n            <a class=\"navbar-item\" href=\"/about\">Nosotros</a>\n            <a class=\"navbar-item\" href=\"/products\">Productos</a>\n            <a class=\"navbar-item\" href=\"/contact\">Contacto</a>\n          </div>\n        </div>\n      </nav>\n    </header>\n  </div>\n  <!-- This allows Vue Router to render the component for the current route -->\n  <router-view/>\n</template>\n\n<script setup>\nimport { ref } from 'vue';\n\n// Reactive state for tracking if the mobile menu is open or closed.\nconst isMenuOpen = ref(false);\n\n// Function to toggle the menu's state.\nconst toggleMenu = () => {\n  isMenuOpen.value = !isMenuOpen.value;\n};\n</script>\n\n<style scoped>\n/* Optional: Add some styling for better presentation */\n.navbar-brand .navbar-item img {\n  max-height: 2.75rem; /* Adjust logo height */\n}\n\n/* Ensure the brand name and logo are vertically centered */\n.navbar-brand .navbar-item.is-align-items-center {\n  display: flex;\n  align-items: center;\n}\n</style>\n"],"mappings":"AAyDA,SAASA,GAAG,QAAQ,KAAK;;AAEzB;;;;;;;;IACA,MAAMC,UAAU,GAAGD,GAAG,CAAC,KAAK,CAAC;;IAE7B;IACA,MAAME,UAAU,GAAGA,CAAA,KAAM;MACvBD,UAAU,CAACE,KAAK,GAAG,CAACF,UAAU,CAACE,KAAK;IACtC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}